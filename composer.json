{
    "name": "arsham-sh/laravel-modular",
    "description": "A Laravel module generator package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "arsham-sh"
        }
    ],
    "require": {
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Arsham\\LaravelModular\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arsham\\LaravelModular\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arsham\\LaravelModular\\LaravelModularServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
